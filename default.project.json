{
  "name": "PopAPeg",
  "emitLegacyScripts": true,
  "serveAddress": "127.0.0.1",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Assets": { "$path": "assets" },
      "CatalogAssets": { "$path": "art/catalog/CatalogAssets.rbxm" },
      "CatalogLibrary": {
        "$className": "Folder",
        "CatalogInfo": { "$path": "scripts/models/CatalogInfo.luau" },
        "CatalogMotion": { "$path": "scripts/models/CatalogMotion.luau" },
        "BlenderChoreography": { "$path": "scripts/models/BlenderChoreography.luau" },
        "CatalogEffects": { "$path": "scripts/models/CatalogEffects.luau" },
        "CatalogEffectProfiles": { "$path": "scripts/models/CatalogEffectProfiles.luau" },
        "CatalogEffectAnchors": { "$path": "scripts/models/CatalogEffectAnchors.luau" },
        "StudioGameModelsAudit": { "$path": "scripts/models/StudioGameModelsAudit.luau" },
        "StudioEffectPlacementAudit": { "$path": "scripts/models/StudioEffectPlacementAudit.luau" },
        "ItemMotion": { "$path": "src/client/ItemMotion.luau" },
        "ItemChoreography": { "$path": "src/client/ItemChoreography.luau" },
        "motion": { "$path": "src/client/motion" },
        "GallerySoundBank": { "$path": "scripts/models/GallerySoundBank.luau" },
        "GallerySoundEngine": { "$path": "scripts/models/GallerySoundEngine.luau" }
      }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "StarterGui": {
      "$properties": { "ScreenOrientation": "Sensor" }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.38, 0.42, 0.52],
        "OutdoorAmbient": [0.38, 0.42, 0.52],
        "Brightness": 2,
        "ClockTime": 13,
        "GlobalShadows": true
      }
    }
  }
}
